{
  "manifest_version": 3,
  "name": "Refund Reconciler (local preview)",
  "short_name": "Refund Reconciler",
  "version": "0.8.0",
  "description": "Beta: manually record refund evidence per returned item and track what is unresolved, kept locally and encrypted by passphrase.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Refund Reconciler",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
